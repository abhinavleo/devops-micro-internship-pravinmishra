#!/bin/bash
# Block commits containing likely secrets or files over 1 MB

set -e
blocked=0

while IFS= read -r -d '' file; do

    if git diff --cached -- "$file" | grep -qE \
    'AKIA[0-9A-Z]{16}|-----BEGIN (RSA|OPENSSH|PRIVATE) KEY-----'; then
        echo "BLOCKED: possible secret in $file"
        blocked=1
    fi

    size=$(git cat-file -s ":$file")

    if [ "$size" -gt 1000000 ]; then
        echo "BLOCKED: $file is $size bytes — over the 1 MB limit"
        blocked=1
    fi

done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "$blocked" -eq 1 ]; then
    echo "Commit rejected. Fix the issues above and try again."
    exit 1
fi